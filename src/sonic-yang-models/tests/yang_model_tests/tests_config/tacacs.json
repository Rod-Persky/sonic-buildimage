    "TACPLUS_TLS_EPSK_TEST": {
        "sonic-system-tacacs:sonic-system-tacacs": {
            "sonic-system-tacacs:TACPLUS_FORWARDER": {
                "global": {
                    "local_listen_address": "127.0.0.1",
                    "local_listen_port": 49
                }
            },
            "sonic-system-tacacs:TACPLUS_SERVER_TLS": {
                "TACPLUS_SERVER_TLS_LIST": [
                {
                    "ipaddress": "192.0.2.20",
                    "priority": 48,
                    "tcp_port": 449,
                    "timeout": 10,
                    "domain_name": "tacacs.example.test",
                    "sni_enabled": true,
                    "single_connection": true,
                    "psk_identity": "client-identity",
                    "psk_secret_ref": "epsk-object-01",
                    "psk_hash": "sha-384",
                    "psk_key_exchange": "psk-dhe",
                    "psk_key_exchange_groups": "x25519:secp384r1"
                }
                ]
            }
        }
    },

    "TACPLUS_FORWARDER_IPV6_TEST": {
        "sonic-system-tacacs:sonic-system-tacacs": {
            "sonic-system-tacacs:TACPLUS_FORWARDER": {
